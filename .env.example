# PINTAR — environment contract (FABLE-01 §1). Placeholders only; real values
# live in the deployment system's secret store. Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
CARD_PEPPER=<random-string-at-least-32-chars>
CARD_EMAIL_DOMAIN=cards.pintar.internal
PINTAR_BUILD_SHA=

# Selftest (CI uses the local Supabase stack; see .github/workflows/ci.yml)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
