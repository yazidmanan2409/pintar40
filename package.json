{
  "name": "pintar40",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx selftest/run.ts",
    "selftest:local": "tsx selftest/run.ts --accept-justified-skips",
    "selftest:only": "tsx selftest/run.ts --accept-justified-skips",
    "selftest:build-identity": "tsx selftest/build-identity.check.ts",
    "selftest:db": "for f in selftest/db/fable0*.sql; do psql -v ON_ERROR_STOP=1 -q -1 -f \"$f\" \"$SUPABASE_DB_URL\" || exit 1; done && psql -v ON_ERROR_STOP=1 -c 'select * from selftest.run_fable01() union all select * from selftest.run_fable02() union all select * from selftest.run_fable03() union all select * from selftest.run_fable04() union all select * from selftest.run_fable05() union all select * from selftest.run_quick_canonical() union all select * from selftest.run_evaluation() union all select * from selftest.run_fable06() union all select * from selftest.run_fable07()' \"$SUPABASE_DB_URL\"",
    "baseline:parity": "node scripts/baseline-parity.mjs",
    "db:golden": "bash scripts/dev/golden-db.sh ensure",
    "db:clone": "bash scripts/dev/golden-db.sh clone",
    "db:status": "bash scripts/dev/golden-db.sh status",
    "plants": "node scripts/dev/plants.mjs",
    "preflight:rpc": "node scripts/dev/reachability.mjs",
    "contoh:buku-kerja": "tsx scripts/contoh-buku-kerja.mts",
    "guard:scan": "node scripts/guard/sensitive-scan.mjs --tree",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.4.5",
    "nodemailer": "^10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsqr": "^1.4.0",
    "server-only": "^0.0.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
